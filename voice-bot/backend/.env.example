# DSA Document AI - Voice backend: configuration contract (environment variables).
# Copy to .env for a local run. Never commit real values. On the voice server (deploy/) they come from SSM
# Parameter Store: /docai-voice/stack-env (written by the stack) and /docai-voice/secrets/<NAME>
# (deploy/secrets.sh). A secret NAME may also be read from NAME_SSM=/docai-voice/<parameter>.

# --- AWS: Mumbai only (the app refuses any other region) -----------------------------------
AWS_REGION=ap-south-1

# --- Bedrock LLM: AWS-sold models only, tried in this order ----------------------------------
# In-Region model ids only: the app refuses cross-Region profiles (global., apac., in., ...) at start-up,
# and the server role may invoke exactly these two models.
LLM_MODEL_CHAIN=moonshotai.kimi-k2.5,openai.gpt-oss-120b-1:0
# Always on (kept for the hosting's env contract): no inference leaves ap-south-1
LLM_MUMBAI_ONLY=true
# Per-model additionalModelRequestFields, JSON (default none), e.g. {"openai.gpt-oss-120b-1:0": {"reasoning_effort": "low"}}
# (Reported on re:Post, Apr 2026: Kimi on Bedrock accepts "thinking"/"enable_thinking" switches but ignores them.)
LLM_MODEL_PARAMS=
# Output tokens incl. hidden reasoning; the spoken reply is kept short by the prompt and a 900-character cap
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3
# Next model when the first stream event takes longer than this...
LLM_FIRST_EVENT_TIMEOUT_S=8
# ...or when there is still neither speech nor a tool call after this (long hidden reasoning)
LLM_FIRST_OUTPUT_TIMEOUT_S=10

# --- Speech: Transcribe streaming + Polly (Kajal, neural) ----------------------------------
# Language at the start of a call: hi-IN (also Hinglish), en-IN or mr-IN. Browser calls pick it per call.
DEFAULT_LANGUAGE=hi-IN
POLLY_VOICE=Kajal
VAD_MIN_VOLUME=0.6
USER_IDLE_SECONDS=12
CALL_MAX_SECONDS=600
# Calls at once across browser, phone and WhatsApp (each holds a Transcribe stream and the VAD/turn models)
MAX_CONCURRENT_CALLS=8

# --- Cognito: the IDP's user pool, so the bot accepts the same logins ------------------------
# aws cognito-idp list-user-pools --max-results 50 --region ap-south-1   (name starts with UserIdentity)
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
# App client id(s) whose ID tokens are accepted, comma-separated
COGNITO_APP_CLIENT_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- IDP (DSA Document AI) backend API, IAM auth (SigV4 with the server role) --------
# CloudFormation output *BackendUrl* of stack IDP-V2-Application, or read from SSM:
IDP_API_URL=
IDP_API_URL_SSM=/idp-v2/backend/url
IDP_CALLER_ID=voice-bot
# Recordings go to this project (by id, or by exact name)
QA_PROJECT_ID=
QA_PROJECT_NAME=Telecaller QA – Sample calls
RECORDING_ENABLED=true
RECORDINGS_DIR=/tmp/voicebot-recordings

# --- Persona -------------------------------------------------------------------------------
ASSISTANT_NAME=Varunika Loans
DSA_NAME=Varunika Loan Partners
# Shown in the mismatch reminder (T5); empty keeps {{dsa_phone}} for the team to fill
DSA_PHONE=

# --- Phone: Plivo / Exotel (off until PHONE_URL_KEY and PUBLIC_HOST are set) -----------------
# The voice CloudFront domain the providers reach, e.g. dxxxxxxxxxxxx.cloudfront.net
PUBLIC_HOST=
# 32+ random characters (deploy/secrets.sh generate PHONE_URL_KEY): seals call tokens. Exotel's URLs carry a key
# derived from it (deploy/secrets.sh exotel-urls prints them), never the key itself
PHONE_URL_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# Rented 022 number in E.164 form, e.g. +9122XXXXXXXX (caller id for outbound calls and transfers)
PLIVO_NUMBER=
PLIVO_API_BASE=https://api.plivo.com
# soxr presets on the 8 kHz line (VHQ, HQ, MQ, LQ, QQ). Pipecat's stock VHQ holds back ~52 ms each way (+~100 ms at
# the start). Bot -> caller: QQ = 0 ms, clean because Polly renders 8 kHz for Plivo calls. Caller -> bot: MQ = ~26 ms
# (QQ would leave images only 18 dB down in what Transcribe hears).
PLIVO_RESAMPLER=QQ
PLIVO_INPUT_RESAMPLER=MQ
PLIVO_VALIDATE_SIGNATURE=true
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=
# India (Mumbai) cluster
EXOTEL_API_BASE=https://api.in.exotel.com
# transfer_to_human dials this number (Plivo); empty = the bot offers a call back instead
TELECALLER_NUMBER=

# --- Outbound calls guard --------------------------------------------------------------------
# Only these numbers may be called (team phones on the signed consent sheet), comma-separated E.164
OUTBOUND_ALLOWED_TO=
CALL_WINDOW=10:00-19:00
CALL_DAYS=mon-sat
OUTBOUND_MAX_ATTEMPTS_PER_DAY=3

# --- WhatsApp Business Calling (off until all four are set) -----------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=
# NAT discovery only (no media goes through it): AWS's public STUN server in Mumbai (Kinesis Video Streams).
# Empty = no STUN (host candidates only).
WHATSAPP_STUN_URLS=stun:stun.kinesisvideo.ap-south-1.amazonaws.com:443

# --- Server ----------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
LOG_JSON=true
# Browser origins allowed on /ws and /calls/outbound (empty = any origin; the token is still required)
ALLOWED_ORIGINS=
